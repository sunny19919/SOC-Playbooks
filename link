// Description: Detects indicators associated with the September 2025 supply chain attack that compromised popular NPM packages like 'chalk' and 'debug'. The malware intercepts and redirects cryptocurrency transactions.
// References:
// - https://www.aikido.dev/blog/npm-debug-and-chalk-packages-compromised
// - https://www.endorlabs.com/learn/major-supply-chain-attack-compromises-popular-npm-packages-including-chalk-and-debug
// - https://www.bleepingcomputer.com/news/security/hackers-hijack-npm-packages-with-2-billion-weekly-downloads-in-supply-chain-attack/
// False Positive Sensitivity: Medium
// Define known indicators of compromise from the threat intelligence
let maliciousDomains = dynamic([
    "npmjs.help",
    "websocket-api2.publicvm.com"
]);
let compromisedPackages = dynamic([
    "backslash", "chalk-template", "supports-hyperlinks", "has-ansi", "simple-swizzle",
    "color-string", "error-ex", "color-name", "is-arrayish", "slice-ansi", "color-convert",
    "wrap-ansi", "ansi-regex", "supports-color", "strip-ansi", "chalk", "debug", "ansi-styles",
    "color", "proto-tinker-wc"
]);
(
    // Look for network connections to the phishing or credential exfiltration domains
    DeviceNetworkEvents
    | where RemoteUrl has_any (maliciousDomains) or RemoteIP has_any (maliciousDomains) // RemoteIP check is for cases where URL isn't parsed
    | extend
        Activity = "NetworkConnectionToMaliciousDomain",
        Tactic = "Command and Control",
        Technique = "T1102", // Web Service
        RuleName = "NPM_Compromise_NetworkIOC"
    | project-reorder Timestamp, DeviceName, Activity, Tactic, Technique, RuleName, RemoteUrl, RemoteIP, InitiatingProcessCommandLine, InitiatingProcessParentFileName
)
| union (
    // Look for command line activity that may indicate an attempt to install the compromised packages
    DeviceProcessEvents
    | where FileName in~ ("npm.cmd", "npm", "yarn.cmd", "yarn")
    | where ProcessCommandLine has_any ("install", "add", "i")
    | where ProcessCommandLine has_any (compromisedPackages)
    // Potential for FPs if developers are running scripts or commands that coincidentally match this pattern (e.g., npm search).
    // Review the full command line for context to confirm an installation attempt.
    | project-reorder Timestamp, DeviceName, FileName, ProcessCommandLine, InitiatingProcessFileName
)
